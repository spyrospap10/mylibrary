<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/app-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAdminSubUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="Χρήστης: spyrospap"/>

        <TextView
            android:id="@+id/tvAdminSubPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Πακέτο: 1 Μήνας (0.99€)"/>

        <TextView
            android:id="@+id/tvAdminSubDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Λήξη: 04/06/2026"
            android:textColor="#D32F2F"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>