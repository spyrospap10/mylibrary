<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Λίστα Δανεισμών"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:id="@+id/layoutAdminFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearchLoan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Αναζήτηση τίτλου..."
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:padding="12dp"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionDone"/>

        <ImageButton
            android:id="@+id/btnFilterLoans"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:src="@android:drawable/ic_menu_sort_by_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutUserTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:visibility="gone">
        <Button
            android:id="@+id/btnActiveLoans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ενεργοί"
            android:backgroundTint="#3F51B5"
            android:textColor="@android:color/white"
            android:layout_marginEnd="4dp"/>
        <Button
            android:id="@+id/btnHistoryLoans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ιστορικό"
            android:backgroundTint="#9E9E9E"
            android:textColor="@android:color/white"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewLoans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvEmptyLoans"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="Δεν υπάρχουν ενεργοί δανεισμοί."
        android:textSize="18sp"
        android:textColor="#757575"
        android:textStyle="italic"
        android:gravity="center"
        android:visibility="gone"/>

</LinearLayout>