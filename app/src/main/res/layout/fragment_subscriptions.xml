<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F5F5">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_dialog_info"
        android:tint="#757575"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvSubscriptionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Δεν έχετε ενεργή συνδρομή."
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:textAlignment="center"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSubscribeNow"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ΚΑΝΤΕ ΣΥΝΔΡΟΜΗ ΤΩΡΑ"
        android:textSize="18sp"
        android:backgroundTint="#FF9800"
        android:textColor="@android:color/white"/>

    <Button
        android:id="@+id/btnStudentDiscount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Είστε φοιτητής ΔΙΠΑΕ;\nΠατήστε εδώ για δωρεάν συνδρομή"
        android:textSize="15sp"
        android:textColor="#3F51B5"
        android:background="@android:color/transparent"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnCancelSubscription"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="ΛΗΞΗ ΣΥΝΔΡΟΜΗΣ"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#D32F2F"
        android:visibility="gone" />

</LinearLayout>